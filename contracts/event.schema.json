{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evento USGS (feature GeoJSON do feed, do FDSN ou do detail)",
  "description": "Só os campos que o projeto usa. mag, depth, type e types podem vir nulos ou vazios.",
  "type": "object",
  "required": ["type", "id", "geometry", "properties"],
  "properties": {
    "type": { "const": "Feature" },
    "id": { "type": "string", "minLength": 1 },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": ["number", "null"] }
          ]
        }
      }
    },
    "properties": {
      "type": "object",
      "required": ["time", "updated", "mag", "status", "type", "types", "ids", "net", "code"],
      "properties": {
        "time": { "type": "integer", "minimum": -62135596800000, "maximum": 253402300799999 },
        "updated": { "type": "integer", "minimum": 0, "maximum": 253402300799999 },
        "mag": { "type": ["number", "null"] },
        "status": { "enum": ["automatic", "reviewed", "deleted"] },
        "type": { "type": ["string", "null"] },
        "types": {
          "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^(,([^,]+,)*)?$" }]
        },
        "ids": { "type": "string", "pattern": "^,([^,]+,)+$" },
        "net": { "type": "string" },
        "code": { "type": "string" },
        "detail": { "type": "string", "pattern": "^https://earthquake\\.usgs\\.gov/" },
        "products": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
